# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_server_id

# Channel IDs
WAITING_ROOM_ID=
CHAMBER_1_ID=
CHAMBER_2_ID=
CHAMBER_3_ID=
CHAMBER_4_ID=
CHAMBER_5_ID=
CHAMBER_6_ID=
INNER_SANCTUM_ID=
OFFERINGS_CHANNEL_ID=
VOWS_CHANNEL_ID=

# Role IDs
LOST_SOUL_ROLE_ID=
GATE_1_ROLE_ID=
GATE_2_ROLE_ID=
GATE_3_ROLE_ID=
GATE_4_ROLE_ID=
GATE_5_ROLE_ID=
GATE_6_ROLE_ID=
GATE_7_ROLE_ID=
ASCENDED_ROLE_ID=
MOD_ROLE_ID=

# Anthropic API (for Ika's AI presence)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Settings
# When true, Gate 5 uses 10-second delays instead of 3-minute
TEST_MODE=false

# Ika Presence Settings
# Chance for Ika to respond passively to chat (0.0 - 1.0)
IKA_PASSIVE_CHANCE=0.35
# Interval between initiated moments in milliseconds (default: 1 hour)
IKA_MOMENT_INTERVAL=3600000
# Enable/disable AI responses (set to false for testing without API)
IKA_AI_ENABLED=true
