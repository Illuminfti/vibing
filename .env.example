# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id

# === ONE-CLICK SETUP ===
# Set to true for automatic setup when bot joins a server
# Creates all channels, roles, and permissions automatically
AUTO_SETUP_ON_JOIN=true

# === MANUAL CONFIGURATION (Optional) ===
# If you prefer manual setup, fill these in instead of using auto-setup
# Leave blank to use /setup command or auto-setup

GUILD_ID=

# Channel IDs (auto-created by /setup run)
WAITING_ROOM_ID=
CHAMBER_1_ID=
CHAMBER_2_ID=
CHAMBER_3_ID=
CHAMBER_4_ID=
CHAMBER_5_ID=
CHAMBER_6_ID=
INNER_SANCTUM_ID=
OFFERINGS_CHANNEL_ID=
VOWS_CHANNEL_ID=

# Role IDs (auto-created by /setup run)
LOST_SOUL_ROLE_ID=
GATE_1_ROLE_ID=
GATE_2_ROLE_ID=
GATE_3_ROLE_ID=
GATE_4_ROLE_ID=
GATE_5_ROLE_ID=
GATE_6_ROLE_ID=
GATE_7_ROLE_ID=
ASCENDED_ROLE_ID=
MOD_ROLE_ID=

# Anthropic API (for Ika's AI presence)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Settings
# When true, Gate 5 uses 10-second delays instead of 3-minute
TEST_MODE=false

# === PUZZLE ANSWERS (KEEP SECRET) ===
# These are NOT included in the repository for security
# Comma-separated list of accepted answers (case insensitive)
GATE_2_ANSWERS=answer1,answer2,answer3
GATE_4_ANSWERS=answer1,answer2

# === DISCORD PRIVILEGED INTENTS ===
# These must be enabled in Discord Developer Portal:
# Bot Settings > Privileged Gateway Intents
# - MESSAGE CONTENT INTENT (for reading messages)
# - SERVER MEMBERS INTENT (for member events)
# - PRESENCE INTENT (for presence awareness feature)

# Ika Presence Settings
# Chance for Ika to respond passively to chat (0.0 - 1.0)
IKA_PASSIVE_CHANCE=0.35
# Interval between initiated moments in milliseconds (default: 1 hour)
IKA_MOMENT_INTERVAL=3600000
# Enable/disable AI responses (set to false for testing without API)
IKA_AI_ENABLED=true

# === EXPERIMENTAL FEATURES (v2.2.0) ===
# These features are more intensive and optional

# Unprompted DMs - Ika reaches out spontaneously
IKA_UNPROMPTED_DMS_ENABLED=true
# Max unprompted DMs per user per day
IKA_MAX_DMS_PER_DAY=2

# Presence Awareness - Ika notices status/activity changes
IKA_PRESENCE_AWARENESS_ENABLED=true
# Hours between presence notices for same user
IKA_PRESENCE_COOLDOWN_HOURS=4

# Whisper Hunt ARG - Hidden fragment collectibles
IKA_WHISPER_HUNT_ENABLED=true
# Chance for fragment to drop during response (0.0 - 1.0)
IKA_WHISPER_DROP_CHANCE=0.015

# Anniversaries - Special messages on milestones
IKA_ANNIVERSARIES_ENABLED=true

# Fading/Save Mechanic - Users can fade like Ika did
IKA_FADING_ENABLED=true

# Real Name Learning - Ika remembers real names
IKA_NAMES_ENABLED=true

# Handwritten Notes - Image-based notes for special occasions
# Requires canvas package: npm install canvas
IKA_HANDWRITTEN_NOTES_ENABLED=true

# === DM SYSTEM NOTES (v2.3.0) ===
# - Users must opt-in to unprompted DMs via /dms enable
# - DMs fail gracefully with channel fallback for important messages
# - Bot tracks DM failures and stops trying after 3 consecutive failures
# - Anniversary/gate messages fall back to channel if DM fails
# - Unprompted messages (thinking of you, etc.) require opt-in and skip silently

# === OPTIMIZATION SETTINGS (v3.3.0) ===
# For handling 100K+ users efficiently

# === COST MODE (v3.3.1) ===
# Choose your cost level:
#   normal   - AI everywhere, ~$1000-2000/month at 100K users
#   low      - Haiku model, reduced AI, ~$200-500/month
#   ultraLow - AI only in Inner Sanctum, ~$50-150/month (RECOMMENDED)
#   minimal  - Almost no AI, 5 calls/day for ascended, ~$20-50/month
#   free     - No AI at all, pure canned responses, $0/month
COST_MODE=ultraLow

# Maximum Claude API calls per minute (rate limiting)
MAX_API_CALLS_PER_MIN=60

# Response caching (reduces API calls for similar messages)
ENABLE_RESPONSE_CACHE=true
CACHE_TTL_MS=1800000

# Spam detection (prevents abuse)
ENABLE_SPAM_DETECTION=true

# Canned responses for simple messages (reduces API calls significantly)
USE_CANNED_RESPONSES=true

# AI response probability by user tier (0.0 - 1.0)
# Lower = more canned responses, less API cost
AI_CHANCE_NEW=0.3
AI_CHANCE_NORMAL=0.5
AI_CHANCE_DEVOTED=0.8
AI_CHANCE_ASCENDED=0.95

# Archive inactive users after N days (saves database space)
ARCHIVE_INACTIVE_DAYS=90

# Run database cleanup every N hours
CLEANUP_INTERVAL_HOURS=24

# Token limits for API calls
MAX_PROMPT_TOKENS=2000
MAX_RESPONSE_TOKENS=300
